          "name": "R6_POST_Duplicate_Email",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "\r\npm.test(\"Từ chối User trùng Email (Status 422)\", function () {\r\n    pm.response.to.have.status(422);\r\n});\r\n\r\n// Kiểm tra lỗi trùng Email\r\npm.test(\"Thông báo Email đã tồn tại\", function () {\r\n    var jsonData = pm.response.json();\r\n\r\n    pm.expect(jsonData).to.be.an(\"array\");\r\n\r\n    var emailError = jsonData.find(function (item) {\r\n        return item.field === \"email\";\r\n    });\r\n\r\n    pm.expect(emailError).to.exist;\r\n    pm.expect(emailError.message).to.eql(\"has already been taken\");\r\n});\r\n"

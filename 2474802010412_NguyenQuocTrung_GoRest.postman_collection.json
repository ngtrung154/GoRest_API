        {
          "name": "R3_Update_User_Status",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "\r\npm.test(\"Cập nhật User thành công (Status 200)\", function () {\r\n    pm.response.to.have.status(200);\r\n});\r\n\r\n// Kiểm tra trạng thái User đã đổi thành inactive\r\npm.test(\"Trạng thái User đã chuyển thành inactive\", function () {\r\n    var jsonData = pm.response.json();\r\n    pm.expect(jsonData.status).to.eql(\"inactive\");\r\n});\r\n\r\n// Kiểm tra User ID không thay đổi\r\npm.test(\"User ID khớp với dữ liệu đã tạo\", function () {\r\n    var jsonData = pm.response.json();\r\n    var expectedId = pm.environment.get(\"userId\");\r\n\r\n    pm.expect(jsonData.id).to.eql(Number(expectedId));\r\n});\r\n"
                ]
              }
            }
          ],
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{token}}",
                  "type": "string"

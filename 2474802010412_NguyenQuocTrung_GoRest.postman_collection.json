  "item": [
    {
      "name": "Positive_Cases",
      "item": [
        {
          "name": "R1_Create_User",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "\r\npm.test(\"Tạo User thành công (Status 201)\", function () {\r\n    pm.response.to.have.status(201);\r\n});\r\n\r\n// Kiểm tra thông tin User khớp với dữ liệu đầu vào\r\npm.test(\"Thông tin User khớp với dữ liệu đầu vào\", function () {\r\n    var jsonData = pm.response.json();\r\n    var requestData = JSON.parse(pm.request.body.raw);\r\n\r\n    pm.expect(jsonData.name).to.eql(requestData.name);\r\n    pm.expect(jsonData.gender).to.eql(requestData.gender);\r\n    pm.expect(jsonData.email).to.eql(requestData.email);\r\n    pm.expect(jsonData.status).to.eql(requestData.status);\r\n});\r\n\r\n// Kiểm tra User ID\r\npm.test(\"User ID được tạo thành công\", function () {\r\n    var jsonData = pm.response.json();\r\n    pm.expect(jsonData.id).to.exist;\r\n});\r\n\r\n// Lưu User ID vào Environment\r\nif (pm.response.code === 201) {\r\n    var jsonData = pm.response.json();\r\n    pm.environment.set(\"userId\", jsonData.id);\r\n}\r\n"
                ]
              }
            }
          ],
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{token}}",
                  "type": "string"
                }
              ]
            },
            "method": "POST",
            "header": [
              {
                "key": "",
                "value": "",
                "disabled": true
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\r\n    \"name\": \"Pham Minh Khoa\",\r\n    \"gender\": \"male\",\r\n    \"email\": \"pham.khoa321@example.com\",\r\n    \"status\": \"active\"\r\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "https://gorest.co.in/public/v2/users",
              "protocol": "https",
              "host": [
                "gorest",
                "co",
                "in"
              ],
              "path": [
                "public",
                "v2",
                "users"
              ]
            }
          },
          "response": []
        },
        {
          "name": "R2_Get_User",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "\r\npm.test(\"Lấy thông tin User thành công (Status 200)\", function () {\r\n    pm.response.to.have.status(200);\r\n});\r\n\r\n// Kiểm tra User ID khớp với dữ liệu đã tạo\r\npm.test(\"User ID khớp với dữ liệu đã tạo\", function () {\r\n    var jsonData = pm.response.json();\r\n    var expectedId = pm.environment.get(\"userId\");\r\n\r\n    pm.expect(jsonData.id).to.eql(Number(expectedId));\r\n});\r\n"
                ]
              }
            },
